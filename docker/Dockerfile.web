# Web (Emscripten / WebAssembly) build image for platform-nes.
#
# Built on the official emscripten/emsdk image, which ships emcc, the Emscripten
# CMake toolchain, node and a prebuilt sysroot cache, with EMSDK already
# exported. SDL3 is compiled from source for wasm by the project's CMake (the
# web-* presets point CMAKE_TOOLCHAIN_FILE at Emscripten.cmake), so the src/SDL3
# backend and the emu core build unchanged:
#
#   docker compose run --rm build-web      # demo.html + demo.js/.wasm/.data
#
# The same image backs CI and local runs, and `act -j web` reuses it.
FROM emscripten/emsdk:latest

ENV DEBIAN_FRONTEND=noninteractive

# emsdk is Debian-based; add the host-side build tools the project needs that
# aren't part of the emsdk image itself. (Ninja is the preset generator;
# git/wget/ca-certificates support FetchContent of intsh/tuple/SDL3.)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ninja-build \
        git \
        wget \
        ca-certificates \
        xz-utils \
        file \
    && rm -rf /var/lib/apt/lists/*

# The intsh/tuple dependencies declare a CMake 4.2 floor (and CMakePresets.json
# needs 3.21+); the emsdk image's bundled CMake can lag behind. Install
# Kitware's official binary, pinned to match the other target images so every
# target stays in lockstep. The symlinks go in /usr/local/bin, ahead of any
# image-provided cmake on PATH.
ARG CMAKE_VERSION=4.3.3
RUN wget -qO- https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz \
        | tar -xz -C /opt \
    && ln -sf /opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/cmake /usr/local/bin/cmake \
    && ln -sf /opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/ctest /usr/local/bin/ctest \
    && ln -sf /opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/cpack /usr/local/bin/cpack

# The container runs as the host user's UID/GID (see compose.yml) so build output
# is owned by the developer, not root. emcc writes compiled sysroot libraries
# into its cache; the image's prebuilt cache is root-owned, so make it writable
# by any UID. CI runs as root (the 0:0 default) and is unaffected.
RUN chmod -R 777 ${EMSDK}/upstream/emscripten/cache

WORKDIR /src
