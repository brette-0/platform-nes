# Cloudflare Pages per-path response headers for the WebAssembly demo.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Staged into the deploy directory by the `web` CI job (.github/workflows/ci.yml)
# alongside index.html + demo.{js,wasm,data}. The Emscripten output filenames are
# NOT content-hashed, so assets use a short browser cache (the Cloudflare edge
# still caches them globally for free, and Pages serves the newest deployment at
# the edge after every push). index.html is never cached so a new deploy shows up
# immediately.

/index.html
  Cache-Control: no-cache

/demo.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=3600

/demo.js
  Cache-Control: public, max-age=3600

/demo.data
  Cache-Control: public, max-age=3600
